# Настройки QDRANT
QDRANT_HOST="localhost"
QDRANT_PORT=6333

# Название модели для эмбеддинга
EMBEDDING_MODEL="unsloth/bge-small-en-v1.5"

# Название коллекции
COLLECTION_NAME="corporate_docs"

# Настройки LLM
